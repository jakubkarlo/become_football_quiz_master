# Copy to .env and fill in. .env is not committed.

# Where `npm run kits:deploy` uploads kits (ssh user@host:absolute path of the volume from docker-compose.yml)
KITS_DEPLOY_TARGET=deploy@quiz.example.com:/data/football-quiz/kits

# Where `npm run stadiums:deploy` uploads generated/stadiums/ (second volume from docker-compose.yml)
STADIUMS_DEPLOY_TARGET=deploy@quiz.example.com:/data/football-quiz/stadium-data
